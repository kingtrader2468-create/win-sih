# ========================================================
# Polar India Hub · Backend Environment Configuration
# ========================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/polar_india_hub_dev
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/polar_india_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/polar_india_hub_dev
# Optional fallback when the local DNS resolver blocks MongoDB Atlas SRV lookups
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Authentication & JWT Configuration
JWT_SECRET=polar-india-hub-sovereign-secret-key-2026-secure-token
JWT_EXPIRES_IN=7d

# Nodemailer SMTP Email Service (OTP verification & password reset)
# If left empty, the server automatically provides in-memory mock dispatch
# with console previews and devOtp response keys for smooth local testing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-institutional-email@gmail.com
EMAIL_PASS=your-16-char-app-specific-password
EMAIL_FROM="Polar India Hub · NCPOR" <no-reply@polar-india-hub.gov.in>

# Google OAuth 2.0 Integration
# (Must match the VITE_GOOGLE_CLIENT_ID configured on the frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Gemini AI Integration (Optional)
# Falls back to deterministic scientific prototype analysis if disabled/missing
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# External Polar Data Adapters (Optional)
EXTERNAL_DATA_ENABLED=false
NASA_EARTHDATA_TOKEN=
NASA_CMR_KEYWORD=polar cryosphere Antarctica Arctic
NASA_CMR_LIMIT=25
NASA_API_KEY=
NASA_MEDIA_QUERIES=Antarctica,Arctic,Himalaya,Greenland,polar cryosphere,sea ice,glacier
NASA_MEDIA_LIMIT=100

# OpenAlex scholarly metadata import (no API key required)
OPENALEX_API_KEY=
OPENALEX_EMAIL=research-admin@example.org
OPENALEX_SEARCH=polar science Antarctica Arctic Himalaya
OPENALEX_PER_PAGE=100
OPENALEX_MAX_WORKS=1000
